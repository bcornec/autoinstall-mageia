PROMPT 10
DEFAULT local
DISPLAY messages
TIMEOUT 50
F1 help.txt

label local
        LOCALBOOT 0

{% for node in nodes -%}
{% if node.role != 'system' and node.role != 'dploy' -%}
{% for machine in node.nodenames -%}
label {{ machine.name }}
  kernel k{{ node.mgaver }}-{{ node.mgaarch }}
  append initrd=i{{ node.mgaver }}-{{ node.mgaarch }}.img automatic=method:http,interface:{{ machine.dif.name }},server:{{ MGADPLOYIP }},directory:/distrib/{{ node.mgaver }}/{{ node.mgaarch }},network:dhcp kickstart=http://{{ MGADPLOYIP }}/ks/{{ machine.name }}_auto_inst.cfg.pl useless_thing_accepted

{% endfor -%}
{% endif -%}
{% endfor -%}

