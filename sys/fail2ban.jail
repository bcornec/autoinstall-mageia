# /etc/fail2ban/jail.local
[DEFAULT]
ignoreip = 127.0.0.1 #x.y.z.t
findtime = 10m
bantime = 24h
maxretry = 3

#[httpd]
#enabled = true
#port = 443
#filter = apache-auth
#backend = systemd
#maxretry = 3
#banaction = httpd
#bantime = 10d
#destemail = root@localhost
#
[sshd]
port = ssh
backend = systemd
filter = sshd
maxretry = 2
banaction = sshd
bantime = 10d
